# Public canonical URL (defaults to https://northbound.studio)
NEXT_PUBLIC_SITE_URL=https://northbound.studio

# Resend API key for /api/contact (https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Destination inbox receiving portfolio inquiries (defaults to hello@northbound.studio)
CONTACT_TO_EMAIL=hello@northbound.studio

# Verified Resend sender address (use onboarding@resend.dev for initial testing before domain verification)
CONTACT_FROM_EMAIL="Northbound Studio <onboarding@resend.dev>"
